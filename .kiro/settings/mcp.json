{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.86",
        "--browser",
        "chrome",
        "--headless",
        "--isolated",
        "--output-dir",
        "playwright-output"
      ],
      "env": {
        "DO_NOT_TRACK": "1"
      },
      "disabled": false
    }
  }
}
